{
  "name": "prism",
  "version": "0.5.0",
  "private": true,
  "description": "Prism — AI news & knowledge distiller",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n vite,sidecar -c blue,magenta --kill-others-on-fail \"npm run dev\" \"npm run sidecar:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "dev:clean": "lsof -ti:1420,8765 | xargs kill -9 2>/dev/null; npm run tauri:dev",
    "tauri:build": "tauri build",
    "freeze-sidecar": "bash scripts/build-sidecar-bin.sh",
    "package:mac": "npm run freeze-sidecar && tauri build",
    "sidecar:dev": "cd python && uv run prism-sidecar",
    "sidecar:install": "cd python && uv sync",
    "smoke": "bash scripts/smoke.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:py": "cd python && uv run ruff check .",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:keystore-check": "cd src-tauri && cargo test --test keystore_smoke -- --nocapture"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
